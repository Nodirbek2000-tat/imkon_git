# Bu fayl git'ga tushadi — namuna sifatida.
# Haqiqiy qiymatlarni `.env` ga yozing (u .gitignore'da).

DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend manzili — CORS va CSRF uchun
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Baza. Bo'sh qoldirilsa SQLite ishlatiladi (faqat local uchun).
# Production: postgres://user:parol@host:5432/dbname
DATABASE_URL=

# Google orqali kirish (OAuth client ID, Web application)
GOOGLE_CLIENT_ID=

# SMS provayder (Eskiz.uz). Bo'sh bo'lsa OTP konsolga chiqariladi.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# JWT
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=30

# Telegram bot orqali kirish. @BotFather -> /newbot dan olinadi.
TELEGRAM_BOT_TOKEN=

# --- To'lov tizimi ---
# Bot backendga shu kalit bilan murojaat qiladi. imkon_bot/.env dagi
# BOT_API_SECRET bilan BIR XIL bo'lishi shart.
BOT_API_SECRET=

# Botning @nomi (@ belgisisiz). Saytda "To'lov qilish" bosilganda
# t.me/<username>?start=order_IM-XXXX ga yo'naltiriladi.
TELEGRAM_BOT_USERNAME=

# Cheklar tushadigan maxfiy kanal ID (-100 bilan boshlanadi)
PAYMENT_CHANNEL_ID=

# Kanalda to'lovni tasdiqlay oladigan Telegram ID'lar, vergul bilan.
# Saytda is_staff akkaunti bo'lganlar bu ro'yxatsiz ham tasdiqlay oladi.
TELEGRAM_ADMIN_IDS=

# Platforma sotuvdan oladigan ulush (foizda)
PLATFORM_COMMISSION_PERCENT=5
